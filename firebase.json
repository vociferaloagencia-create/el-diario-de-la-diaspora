{
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "El Diario de la Diaspora",
        "authorizedRedirectUris": [
          "https://el-diario-de-la-diaspora-main.vercel.app/__/auth/handler",
          "https://el-diario-de-la-diaspora.firebaseapp.com/__/auth/handler",
